translate japanese story_ch03_8924030a4104_2:
    voice voice_file("v_8924030a4104")
    u "Claude？"

translate japanese story_ch03_b69dc3a26bb9_1:
    narrator "ピアノの音が止まった。"

translate japanese story_ch03_693049a7b4a0_1:
    voice voice_file("v_f90c6e8d1792")
    cl "……なによ、何か用？"

translate japanese story_ch03_d838577a1233_1:
    voice voice_file("v_9ea8fe3240f7")
    u "いや、別に用ってわけじゃないけど。ただ、ちょっと顔を見ようと思って"

translate japanese story_ch03_884a4a2a40aa_1:
    voice voice_file("v_7234478c02cc")
    cl "私の顔なんか見て、何が楽しいのよ"

translate japanese story_ch03_84da8e4b838d_2:
    narrator "彼女は振り返らなかった。"

translate japanese story_ch03_34c2f7d545f9_1:
    voice voice_file("v_265802f13526")
    u "あのさ、昨日のことだけど……"

translate japanese story_ch03_a80a9c707220_1:
    voice voice_file("v_ac06898999f0")
    cl "もういいわよ"

translate japanese story_ch03_79df7f199e31_2:
    voice voice_file("v_9ce8421e4f13")
    u "だけど――"

translate japanese story_ch03_a7a1ea2d8e8f_1:
    voice voice_file("v_9e67b5c586f1")
    cl "いいって言ってるでしょ"

translate japanese story_ch03_7584fdb7fa95_1:
    narrator "彼女の声は決して大きくなかった。"
    narrator "怒っている様子すらなかった。"
    narrator "ただ、あまりにも静かで落ち着き払っていることが、かえって俺を戸惑わせた。"

