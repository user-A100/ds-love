    voice voice_file("v_0c11f05da2f2")
    ds "User……"

translate japanese story_ch03_8517678f9232_1:
    voice voice_file("v_a4854e6b19b2")
    u "どうした？"

translate japanese story_ch03_ff9325cdba9c_1:
    voice voice_file("v_a762d5bc0723")
    ds "わ、私、なんだか緊張してきたかも……"

translate japanese story_ch03_170b1a30ece6_1:
    voice voice_file("v_682968c1c43b")
    u "あんなに楽しみにしてたじゃないか"

translate japanese story_ch03_2d915fcb1f19_1:
    voice voice_file("v_2543c98148df")
    ds "楽しみなのと緊張するのは別だもん！"

translate japanese story_ch03_d2237cb6690c_1:
    narrator "彼女は大きく深呼吸をした。"

translate japanese story_ch03_7875f60d5525_1:
    voice voice_file("v_185dce198f48")
    ds "もし私が大失敗しちゃったらどうしよう？"

translate japanese story_ch03_6257e42bc640_1:
    voice voice_file("v_ab4c6e8bb9c5")
    u "そしたら、みんなで一緒に大失敗するさ"

translate japanese story_ch03_8a10fb6a7ccc_3:
    voice voice_file("v_e33d1659dc6b")
    ds "えっ？"

translate japanese story_ch03_3f6d5d47da6a_1:
    voice voice_file("v_acb944691a39")
    u "だってこれ、俺たちみんなで準備してきたステージだからな"

translate japanese story_ch03_05400f1a53de_1:
    narrator "彼女はきょとんと目を丸くしたあと。"
    narrator "ふわりと笑顔を咲かせた。"

translate japanese story_ch03_d5d8deac3158_1:
