    voice voice_file("v_2ebe065a7062")
    u "ほ、本当にいいんですか？"

translate japanese story_ch02_9777a8d64900_2:
    voice voice_file("v_1e05c6395ac3")
    gp "ええ"

translate japanese story_ch02_e6221c0190be_1:
    voice voice_file("v_6fa8cb134522")
    gp "でも、ひとつだけ約束してちょうだい"

translate japanese story_ch02_4bc7badb508b_1:
    voice voice_file("v_82cbd4f4d414")
    u "約束、ですか？"

translate japanese story_ch02_3fe91e9f90fd_1:
    voice voice_file("v_a1c1ce987c0f")
