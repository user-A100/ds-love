translate japanese story_ch05_d6e26f54e553_1:
    voice voice_file("v_20f499b1e8fc")
    u "心配か？"

translate japanese story_ch05_9158127ba4a7_2:
    voice voice_file("v_33340d2e60f2")
    cl "別に、そこまでは"

translate japanese story_ch05_86e09efb4714_2:
