    voice voice_file("v_a021d890dedc")
    u "初めまして"

translate japanese story_ch05_c3996e2c7406_1:
    voice voice_file("v_e89f430ae21f")
    mother "Claudeから、よく聞いているわ"

translate japanese story_ch05_6bfebb77027d_1:
    voice voice_file("v_2613626143d0")
    cl "お母さん！"

translate japanese story_ch05_7858fd0b30c6_1:
    voice voice_file("v_d915a3da22a8")
    mother "あら、何か間違ったことを言ったかしら？"

