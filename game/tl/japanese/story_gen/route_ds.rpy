    voice voice_file("v_51a5ecf1d639")
    ds "User！"

translate japanese story_route_ds_8517678f9232_1:
    voice voice_file("v_a4854e6b19b2")
    u "どうした？"

translate japanese story_route_ds_7cd82d918799_1:
    voice voice_file("v_978bfaa18809")
    ds "すっごく大事なお知らせがあるんだ！"

translate japanese story_route_ds_39cfb3e6bc12_1:
    voice voice_file("v_b8f82542d187")
    u "また、小説を書き終わったのか？"

