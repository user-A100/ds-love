    voice voice_file("v_57f0ba8c5650")
    u "……出国？" id story_ch04_57f0ba8c5650_1
    voice voice_file("v_546ed41a48db")
    teacher "你不知道吗？" id story_ch04_546ed41a48db_1
    ## 演出: 旁白
