    voice voice_file("v_0c3042b0435d")
    cl "那是什么样？" id story_ch04_0c3042b0435d_1
    narrator "我没有立刻回答。" id story_ch04_5a5d42383828_1
    narrator "Claude 轻轻合上乐谱。" id story_ch04_fb792a635a7b_1
    voice voice_file("v_a63be3156cd4")
    cl "算了。" id story_ch04_a63be3156cd4_1
    voice voice_file("v_ca7ca53b4d45")
    cl "反正我本来就打算去欧洲。" id story_ch04_ca7ca53b4d45_1
    voice voice_file("v_a496cc48b5bd")
    cl "你不需要因为我改变自己的计划。" id story_ch04_a496cc48b5bd_1
    voice voice_file("v_66b4f06aedbf")
    u "可你至少应该告诉我。" id story_ch04_66b4f06aedbf_1
    voice voice_file("v_af319455907e")
