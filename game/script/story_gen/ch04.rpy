    u "嗯？" id story_ch04_7235f2204469_2
    voice voice_file("v_1fbbb8c02ce2")
    gp "如果有一天，你真的想清楚了。" id story_ch04_1fbbb8c02ce2_1
    voice voice_file("v_685ac9237b7c")
    gp "就不要再犹豫了。" id story_ch04_685ac9237b7c_1
