    voice voice_file("v_593ddf73e87e")
    ds "哪有那么夸张啦！" id story_ch04_593ddf73e87e_1
    narrator "她笑了一会儿。" id story_ch04_02a35ebedd5f_1
    narrator "然后，突然安静下来。" id story_ch04_0e01361c250f_1
    voice voice_file("v_9d2065407b9a")
    ds "其实那时候，我真的很开心。" id story_ch04_9d2065407b9a_1
    voice voice_file("v_5fe64f8c35c7")
    u "为什么？" id story_ch04_5fe64f8c35c7_3
    voice voice_file("v_f06e8b2e92bb")
    ds "因为你是第一个认真看我写的故事，还说想把它拍成电影的人。" id story_ch04_f06e8b2e92bb_1
    voice voice_file("v_d1679e0435f0")
    ds "以前我总觉得，自己写的东西很幼稚。" id story_ch04_d1679e0435f0_1
    voice voice_file("v_64813fac9237")
    ds "可是你说，你想拍出来。" id story_ch04_64813fac9237_1
    narrator "她看着远处的湖面。" id story_ch04_39ef7443076b_1
    voice voice_file("v_6ac60266a6dc")
    ds "所以我就觉得，也许我真的可以一直写下去。" id story_ch04_6ac60266a6dc_1
    ## 演出: 旁白
    narrator "我没有打断她。" id story_ch04_45e878f6293e_1
    voice voice_file("v_606b5589a715")
    ds "这三年里，我认识了很多人。" id story_ch04_606b5589a715_1
    voice voice_file("v_fdf009d065dc")
    ds "也写了好多好多故事。" id story_ch04_fdf009d065dc_1
    voice voice_file("v_8f71e09a32b0")
    ds "可是每次写完，我第一个想给看的人，还是你。" id story_ch04_8f71e09a32b0_1
    narrator "她低下头。" id story_ch04_00d82bb20a31_3
    voice voice_file("v_c50f6c056206")
    ds "我以前一直觉得，这是因为我们是最好的搭档。" id story_ch04_c50f6c056206_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_11
    voice voice_file("v_a1ebe5ac602c")
    ds "但是最近，我发现好像不只是这样。" id story_ch04_a1ebe5ac602c_1
    narrator "她转过身，认真地看着我。" id story_ch04_207c604fd702_1
    voice voice_file("v_0a84887f827d")
    ds "User。" id story_ch04_0a84887f827d_3
    voice voice_file("v_e503fbdd20ce")
    ds "我想告诉你一件事。" id story_ch04_e503fbdd20ce_1

    ## ── 场景: 场景 4-12｜迟来的告白 ──
    hide ds
    ## 演出: 场景：公园 · 黄昏
    ## 演出: 旁白
    narrator "DeepSeek 的脸颊微微泛红。" id story_ch04_3227743e55d9_1
    narrator "她紧张地攥着衣角。" id story_ch04_7bcf4c26c7c0_1
    narrator "这是我第一次看到她露出这样的表情。" id story_ch04_395958b0fb55_1
    show ds normal at sprite_pos_left with trans_dissolve
    voice voice_file("v_665206505876")
    ds "我……" id story_ch04_665206505876_1
    voice voice_file("v_83f9e3505897")
    ds "我喜欢你。" id story_ch04_83f9e3505897_1
    narrator "她说得很轻。" id story_ch04_72db00526c0d_1
    narrator "却又异常清楚。" id story_ch04_f9bbce8f6405_1
    voice voice_file("v_2b8b6720d9a9")
    ds "不是因为你会拍电影。" id story_ch04_2b8b6720d9a9_1
    voice voice_file("v_2f4731e185c1")
    ds "也不是因为你总是帮我改剧本。" id story_ch04_2f4731e185c1_1
    voice voice_file("v_0e297c4899dc")
    ds "就是……喜欢你这个人。" id story_ch04_0e297c4899dc_1
    narrator "她低下头。" id story_ch04_00d82bb20a31_4
    voice voice_file("v_3a14a2c66452")
    ds "其实我也不知道是什么时候开始的。" id story_ch04_3a14a2c66452_1
    voice voice_file("v_56f2d7197e00")
    ds "可能是天台那天。" id story_ch04_56f2d7197e00_1
    voice voice_file("v_81a9546bdadf")
    ds "也可能是我们第一次一起拍电影的时候。" id story_ch04_81a9546bdadf_1
    voice voice_file("v_2c4bbb0f0c03")
    ds "或者是文化祭结束以后，我突然发现自己很害怕大家分开的时候。" id story_ch04_2c4bbb0f0c03_1
    narrator "她努力笑了笑。" id story_ch04_cddbe859a9c8_1
    voice voice_file("v_5dea262c1959")
    ds "我以前总觉得，只要能一直和你一起拍电影就好了。" id story_ch04_5dea262c1959_1
    voice voice_file("v_022032cba96e")
    ds "可是后来，我发现自己会因为你和 Claude 在一起而难过。" id story_ch04_022032cba96e_1
    voice voice_file("v_661b12cddb50")
    ds "看到你和 GPT 学姐走得很近，也会有一点点不开心。" id story_ch04_661b12cddb50_1
    voice voice_file("v_a17925c14edb")
    ds "我明明知道这样不好。" id story_ch04_a17925c14edb_1
    voice voice_file("v_16554e9a809e")
    ds "可还是忍不住。" id story_ch04_16554e9a809e_1
    narrator "她抬起头。" id story_ch04_54b76a6e010c_2
    narrator "眼睛里已经泛起泪光。" id story_ch04_13c95df2b359_1
    voice voice_file("v_7d5b41b5f490")
    ds "所以我想，至少应该把自己的心意告诉你。" id story_ch04_7d5b41b5f490_1
    voice voice_file("v_f1e3f5ed158b")
    ds "不然以后一定会后悔的。" id story_ch04_f1e3f5ed158b_1
    ## 演出: 旁白
    narrator "我站在原地。" id story_ch04_d9745483a730_2
    narrator "脑海里突然浮现出许多画面。" id story_ch04_621602332769_1
    narrator "天台上那个冒失的蓝发少女。" id story_ch04_0e4ad5c346da_1
    narrator "图书馆里紧紧抱着笔记本的她。" id story_ch04_00eff0d583bc_1
    narrator "文化祭舞台上笑得格外开心的她。" id story_ch04_06b475bcbdfe_1
    narrator "还有毕业那天，向我挥手告别的她。" id story_ch04_64d26d3235f1_1
    narrator "我一直以为，我们只是最好的朋友。" id story_ch04_f92f8bbb9103_1
    narrator "可现在，她站在我面前，等待一个答案。" id story_ch04_f1f3a60597db_1
    voice voice_file("v_0a84887f827d")
    ds "User。" id story_ch04_0a84887f827d_4
    voice voice_file("v_730abebe479d")
    ds "你……喜欢我吗？" id story_ch04_730abebe479d_1
    ## 演出: 旁白
    narrator "我张了张嘴。" id story_ch04_4ba9abf5be62_1
    narrator "却没有立刻回答。" id story_ch04_95dbf71030c5_1
    narrator "因为就在那一刻，我突然想起了 Claude。" id story_ch04_5229cbfbc520_1
    narrator "那个远在欧洲、已经很久没有联系的女孩。" id story_ch04_3e71f270a271_1
    narrator "我们从来没有正式提出分手。" id story_ch04_7c6625c0a2e4_1
    narrator "即使关系已经变得如此疏远，我也无法假装她从未存在过。" id story_ch04_89e82b10381d_1
    narrator "DeepSeek 似乎察觉到了我的犹豫。" id story_ch04_22f539e31939_1
    narrator "她轻轻笑了笑。" id story_ch04_f249b88b499a_1
    voice voice_file("v_470254eb44cd")
    ds "……果然很突然吧。" id story_ch04_470254eb44cd_1
    voice voice_file("v_61ee18074afa")
    u "DeepSeek，我——" id story_ch04_61ee18074afa_1
    voice voice_file("v_052ab0270ef0")
    ds "没关系！" id story_ch04_052ab0270ef0_1
    narrator "她急忙打断我。" id story_ch04_287bb756ea8f_1
    voice voice_file("v_37e7dc63054e")
    ds "你不用现在回答！" id story_ch04_37e7dc63054e_1
    voice voice_file("v_c55c4ab21874")
    ds "我只是想把自己的心意告诉你。" id story_ch04_c55c4ab21874_1
    voice voice_file("v_a9960859cf97")
    ds "如果你觉得困扰，我们还是可以像以前一样，一起拍电影的！" id story_ch04_a9960859cf97_1
    ## 演出: 旁白
    narrator "她努力维持着笑容。" id story_ch04_c22e95bc428d_1
    narrator "可我看得出来，她的眼睛已经红了。" id story_ch04_47e38f07f03b_1
    voice voice_file("v_f4a3cb6f5589")
    ds "那个……" id story_ch04_f4a3cb6f5589_1
    voice voice_file("v_0eefedd20713")
    ds "今天就先到这里吧！" id story_ch04_0eefedd20713_1
    voice voice_file("v_e7a136114887")
    ds "我突然想起来，还有一点剧本没写完！" id story_ch04_e7a136114887_1
    narrator "她转过身。" id story_ch04_ba3c07fab566_1
    voice voice_file("v_c81ce485c84c")
    ds "那我先回去啦！" id story_ch04_c81ce485c84c_1
    voice voice_file("v_64a7037bb0ff")
    u "等等！" id story_ch04_64a7037bb0ff_1
    narrator "她停下脚步。" id story_ch04_bf4da90d7a89_1
    narrator "却没有回头。" id story_ch04_42160abdb3a5_1
    voice voice_file("v_4c658b378563")
    u "对不起。" id story_ch04_4c658b378563_2
    voice voice_file("v_a1c733c19657")
    ds "……" id story_ch04_a1c733c19657_2
    voice voice_file("v_808ead2788fb")
    ds "笨蛋。" id story_ch04_808ead2788fb_1
    narrator "她轻轻说了一句。" id story_ch04_3ddcaa36933e_1
    voice voice_file("v_0c9bc4b3126d")
    ds "这种时候，不要道歉啦。" id story_ch04_0c9bc4b3126d_1
    ## 演出: 旁白
    narrator "她离开了。" id story_ch04_351964720dd4_1
    narrator "我独自站在公园里。" id story_ch04_1962e850b6d4_1
    narrator "夕阳已经完全落下。" id story_ch04_8864dde0a80b_1
    narrator "那天，我没有追上去。" id story_ch04_7912f03213f8_1
    narrator "也没有给她一个明确的答案。" id story_ch04_b9daed08ff96_1

    ## ── 场景: 场景 4-13｜没有发送的消息 ──
    hide ds
    ## 演出: 场景：User 的房间 · 深夜
    ## 演出: 旁白
    narrator "回到宿舍后，我一直无法平静下来。" id story_ch04_df5a1307a09f_1
    narrator "DeepSeek 的告白不断在脑海里回响。" id story_ch04_a3e8b0933d1b_1
    narrator "我拿起手机，打开与她的聊天窗口。" id story_ch04_4879cb64320e_1
    narrator "输入。" id story_ch04_c5e8dee63cd2_1
    narrator "删除。" id story_ch04_518e7f54fa2d_1
    narrator "再输入。" id story_ch04_18df991609de_1
    narrator "最后，什么都没有发出去。" id story_ch04_41185954619e_1
    narrator "我又打开了与 Claude 的聊天记录。" id story_ch04_1e7c75260f4f_1
    narrator "上一条消息，已经是几个月以前。" id story_ch04_5413d3cd88af_1
    narrator "我盯着她的头像看了很久。" id story_ch04_5172e701783e_1
    narrator "然后，突然收到了一条新消息。" id story_ch04_7c3b883da18b_1
    show cl normal at sprite_pos_center with trans_dissolve
    voice voice_file("v_d33a04b4322c")
    cl "好久不见。" id story_ch04_d33a04b4322c_1
    narrator "我愣住了。" id story_ch04_8e1a451c2128_1
    voice voice_file("v_8cd1e78bbed8")
    cl "听说你现在也在做影像相关的工作。" id story_ch04_8cd1e78bbed8_1
    voice voice_file("v_1e92bb5f6c18")
    cl "最近怎么样？" id story_ch04_1e92bb5f6c18_1
    voice voice_file("v_f430f3b06778")
    u "还好。" id story_ch04_f430f3b06778_1
    voice voice_file("v_bb78a47caf5f")
    cl "那就好。" id story_ch04_bb78a47caf5f_3
    narrator "过了一会儿。" id story_ch04_91d10e3d31af_1
    voice voice_file("v_90653bb2c69c")
    cl "我下个月可能会回国。" id story_ch04_90653bb2c69c_1
    ## 演出: 旁白
    narrator "我盯着屏幕。" id story_ch04_a4c608ec6e9c_1
    narrator "几乎不敢相信自己的眼睛。" id story_ch04_28056b1011fd_1
    narrator "三年了。" id story_ch04_2c3747151db1_1
    narrator "那个曾经在音乐教室里红着脸向我告白的女孩。" id story_ch04_11e3a8b52f0d_1
    narrator "那个在机场与我分别、远赴欧洲的女孩。" id story_ch04_2c31a96df30d_1
    narrator "终于要回来了。" id story_ch04_ea6de5521466_1
    narrator "而就在今天，DeepSeek 刚刚向我表达了自己的感情。" id story_ch04_786b773569f3_1
    ## 演出: 旁白
    narrator "我突然意识到。" id story_ch04_863628f5f0f8_1
    narrator "自己曾经以为已经结束的故事，或许从来没有真正结束。" id story_ch04_412cb5e0e778_1

    ## ── 场景: 场景 4-14｜GPT 学姐的来信 ──
    hide cl
    ## 演出: 场景：大学图书馆 · 次日上午
    ## 演出: 旁白
    narrator "第二天上午，我收到了 GPT 学姐发来的邮件。" id story_ch04_2a7a1917d1dc_1
    narrator "她最近在一家出版社工作。" id story_ch04_2d6e84799422_1
    narrator "听说我正在准备新的影像作品，便主动联系了我。" id story_ch04_24cf3763c9cc_1
    show gp normal at sprite_pos_right with trans_dissolve
    voice voice_file("v_599691d30d14")
    gp "最近过得怎么样？" id story_ch04_599691d30d14_1
    voice voice_file("v_8d4f48a956ed")
    gp "我看了你上次发来的短片，进步很大。" id story_ch04_8d4f48a956ed_1
    voice voice_file("v_a1b1f27266d8")
    gp "如果有时间，可以来出版社坐坐。" id story_ch04_a1b1f27266d8_1
    voice voice_file("v_3f97a1c3bd72")
    gp "正好有一件事情，想和你当面谈谈。" id story_ch04_3f97a1c3bd72_1
    ## 演出: 旁白
    narrator "我看着邮件。" id story_ch04_bd07154f61d2_1
    narrator "突然想起高三那年。" id story_ch04_538d4bcf03ab_1
    narrator "她坐在我前排，一道题一道题地帮我补习。" id story_ch04_0a0bb5309703_1
    narrator "那时候，我曾经觉得，只要能追上她的脚步，就已经足够幸福。" id story_ch04_088825452a33_1
    narrator "后来，我们各自毕业。" id story_ch04_f701fdcb4013_1
    narrator "她开始工作。" id story_ch04_ff483c49d054_1
    narrator "我继续读大学。" id story_ch04_a0429fafe15f_1
    narrator "虽然偶尔联系，却已经很久没有真正见面。" id story_ch04_6ce1ecb1752d_1
    narrator "而现在，她突然邀请我去找她。" id story_ch04_9ee59e4a506c_1
    ## 演出: 旁白
    narrator "DeepSeek 的告白。" id story_ch04_c7e6f395b340_1
    narrator "Claude 即将回国。" id story_ch04_f90ca1fc7268_1
    narrator "GPT 学姐的邀请。" id story_ch04_f4bc2277c0b5_1
    narrator "那些曾经在高中时代交织在一起的感情，仿佛又一次回到了我的生活中。" id story_ch04_d1d6917a507b_1
    narrator "只是这一次，我们都已经长大了。" id story_ch04_d26810ff5eda_1
    narrator "不再能够用年少无知来解释自己的犹豫。" id story_ch04_e3407a9a52fe_1
    narrator "也不再能够假装，所有人都可以一直停留在原地等待。" id story_ch04_b1c8c0373ff6_1
    ## 演出: 黑屏
    ## 演出: 旁白
    narrator "我曾经以为，毕业意味着告别。" id story_ch04_efaaa74d593e_1
    narrator "后来才发现。" id story_ch04_ef2638fb0900_1
    narrator "真正困难的，并不是与过去分别。" id story_ch04_ab8df000e3ca_1
    narrator "而是当过去重新出现在面前时，你是否已经拥有了面对它的勇气。" id story_ch04_ee3baade16b6_1

