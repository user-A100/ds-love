    narrator "那天放学后，我直接去了音乐教室。" id story_ch04_d30ace055a5a_1
    narrator "Claude 正在收拾乐谱。" id story_ch04_7531b09cbe19_1
    voice voice_file("v_be6ecfb28db9")
