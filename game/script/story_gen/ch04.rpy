    narrator "她看了我一会儿。" id story_ch04_76c6f49d36d8_1
    narrator "最终还是坐回钢琴前。" id story_ch04_e5b48bc246bc_1
    voice voice_file("v_a6fcbe6bcf41")
    cl "……最后一次。" id story_ch04_a6fcbe6bcf41_1
    ## 演出: 旁白
    narrator "我拿起吉他。" id story_ch04_06b8442ddb14_1
    narrator "她按下琴键。" id story_ch04_6b158167d632_1
    narrator "熟悉的旋律重新响起。" id story_ch04_289cf86538e4_1
    narrator "一开始，我还是弹错了几个地方。" id story_ch04_5204858b06fe_1
    narrator "Claude 像以前一样停下来纠正我。" id story_ch04_8a6fbc2f8fa4_1
    voice voice_file("v_299d41e7006f")
    cl "这里不是这样。" id story_ch04_299d41e7006f_1
    voice voice_file("v_0a4a4831507a")
    u "抱歉。" id story_ch04_0a4a4831507a_1
    voice voice_file("v_f993dd659f2e")
    cl "手指往上移一点。" id story_ch04_f993dd659f2e_1
    voice voice_file("v_8dc6e7de272a")
    u "这样？" id story_ch04_8dc6e7de272a_1
    voice voice_file("v_e0411922a481")
    cl "……对。" id story_ch04_e0411922a481_1
    narrator "我们反复练习。" id story_ch04_96938f08c3a1_1
    narrator "仿佛又回到了文化祭前的那些下午。" id story_ch04_8e90809e281e_1
    narrator "那时候，我们总觉得还有明天。" id story_ch04_5e18532ca950_1
    narrator "今天练不好，明天可以继续。" id story_ch04_08c8b848b4d7_1
    narrator "明天不行，还有后天。" id story_ch04_964dc7222804_1
    narrator "可现在，已经没有那么多时间了。" id story_ch04_79674c47a0c2_1
    narrator "一曲结束。" id story_ch04_8f76aa2ad0df_1
    narrator "Claude 的手指依然停留在琴键上。" id story_ch04_85558db5d0ef_1
    voice voice_file("v_6dd94c32a7ff")
    cl "……你进步了。" id story_ch04_6dd94c32a7ff_1
    voice voice_file("v_6a046b90b87a")
    u "多亏了你。" id story_ch04_6a046b90b87a_1
    voice voice_file("v_c957cc987a6e")
    cl "少来。" id story_ch04_c957cc987a6e_1
    narrator "她低下头。" id story_ch04_00d82bb20a31_2
    voice voice_file("v_f6b1f0e1cc03")
    cl "以后我不在，你也要自己练。" id story_ch04_f6b1f0e1cc03_1
    voice voice_file("v_88c9b8aa98f4")
    u "嗯。" id story_ch04_88c9b8aa98f4_3
    voice voice_file("v_5aa9c5f602a7")
    cl "别再总是弹错那些简单的地方。" id story_ch04_5aa9c5f602a7_1
    voice voice_file("v_333e949d441c")
    u "好。" id story_ch04_333e949d441c_1
    voice voice_file("v_8a4433b24433")
    cl "还有……" id story_ch04_8a4433b24433_1
    narrator "她停住了。" id story_ch04_3311f2cffd34_1
    voice voice_file("v_fd8b5b6c3f58")
    u "还有什么？" id story_ch04_fd8b5b6c3f58_1
    voice voice_file("v_7dcb22443886")
    cl "没什么。" id story_ch04_7dcb22443886_1
    narrator "她站起来，背对着我。" id story_ch04_bd249cd71fb5_1
    voice voice_file("v_24e0f3590516")
    cl "你回去吧。" id story_ch04_24e0f3590516_1
    voice voice_file("v_674763ce4358")
    u "Claude。" id story_ch04_674763ce4358_1
    voice voice_file("v_d6bb00ebdcec")
    cl "……" id story_ch04_d6bb00ebdcec_2
    voice voice_file("v_d2a7b584c3bb")
    u "你真的想走吗？" id story_ch04_d2a7b584c3bb_1
    narrator "她没有回答。" id story_ch04_7e39b093d0d6_1
    narrator "过了很久，才轻声开口。" id story_ch04_e474519bb714_1
    voice voice_file("v_7e97d5a74a00")
    cl "我从小就一直在学钢琴。" id story_ch04_7e97d5a74a00_1
    voice voice_file("v_8ba7089a129e")
    cl "去欧洲，是很早以前就决定好的事情。" id story_ch04_8ba7089a129e_1
    voice voice_file("v_7b0d860cefd7")
    u "我知道。" id story_ch04_7b0d860cefd7_1
    voice voice_file("v_2fbf8ddd3844")
    cl "所以……" id story_ch04_2fbf8ddd3844_1
    narrator "她握紧了手中的乐谱。" id story_ch04_4dce175e4679_1
    voice voice_file("v_37f5233725a5")
    cl "不要让我觉得，留下来也许会更好。" id story_ch04_37f5233725a5_1
    ## 演出: 旁白
    narrator "我站在原地。" id story_ch04_d9745483a730_1
    narrator "第一次清楚地意识到，她并不是不想留下。" id story_ch04_cf2615961539_1
    narrator "只是比起留在这里，她更害怕自己成为一个为了感情放弃梦想的人。" id story_ch04_065e7c625aa1_1
    narrator "而我，却直到她即将离开，才开始认真思考我们之间的关系。" id story_ch04_d91e5bd502a0_1

    ## ── 场景: 第五幕：迟来的坦白 ──
    hide cl
    ## 演出: 场景 4-05｜Claude 家 · 出国前夜
    ## 演出: 旁白
    narrator "Claude 出国的前一天，我收到了一条消息。" id story_ch04_62741382df53_1
    show cl normal at sprite_pos_center with trans_dissolve
    voice voice_file("v_011fa3324e90")
    cl "有些东西还放在我这里。" id story_ch04_011fa3324e90_1
    voice voice_file("v_d5e058a7fdb7")
    cl "如果你想要，就过来拿。" id story_ch04_d5e058a7fdb7_1
    narrator "我知道，她说的是文化祭时留下的乐谱和录像。" id story_ch04_16b4e850f891_1
    narrator "可当我来到她家时，却发现她已经把所有东西都整理好了。" id story_ch04_d6fa5fc8ca0d_1
    narrator "房间里放着几个行李箱。" id story_ch04_f665583fae6d_1
    narrator "钢琴旁，只剩下我们当初一起练习的那份乐谱。" id story_ch04_43bc6cbb61e7_1
    voice voice_file("v_176c646c3498")
    u "明天几点的飞机？" id story_ch04_176c646c3498_1
    voice voice_file("v_44e7c70042b6")
    cl "上午。" id story_ch04_44e7c70042b6_1
    voice voice_file("v_9d54a8de48da")
    u "这么早？" id story_ch04_9d54a8de48da_1
    voice voice_file("v_c80cfcd6772d")
    cl "嗯。" id story_ch04_c80cfcd6772d_2
    narrator "她把一个文件袋递给我。" id story_ch04_a8dafee62676_1
    narrator "里面是文化祭的照片、乐谱，以及我们第一次排练时留下的录音。" id story_ch04_64462117bb5e_1
    voice voice_file("v_dfacd7f84583")
    cl "这些你拿回去吧。" id story_ch04_dfacd7f84583_1
    voice voice_file("v_269b1c883118")
    u "你不留着吗？" id story_ch04_269b1c883118_1
    voice voice_file("v_27c911cdff4c")
    cl "我已经有备份了。" id story_ch04_27c911cdff4c_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_4
    voice voice_file("v_3a1dfc6de9ec")
    cl "怎么了？" id story_ch04_3a1dfc6de9ec_1
    voice voice_file("v_948afd2c5bae")
    u "没什么。" id story_ch04_948afd2c5bae_1
    narrator "我接过文件袋。" id story_ch04_3141460fff22_1
    narrator "却没有离开。" id story_ch04_e4f69691df39_1
    voice voice_file("v_cf517a036573")
    cl "还有事？" id story_ch04_cf517a036573_1
    voice voice_file("v_674763ce4358")
    u "Claude。" id story_ch04_674763ce4358_2
    voice voice_file("v_e6d8025459ef")
    cl "嗯？" id story_ch04_e6d8025459ef_1
    voice voice_file("v_575a09bdc1b1")
    u "你还喜欢我吗？" id story_ch04_575a09bdc1b1_1
    narrator "她怔住了。" id story_ch04_e1f619258402_1
    voice voice_file("v_a18301db373b")
    cl "……你为什么突然问这个？" id story_ch04_a18301db373b_1
    voice voice_file("v_c78aab79b9eb")
    u "因为我想知道。" id story_ch04_c78aab79b9eb_1
    narrator "她别过脸。" id story_ch04_64a1a595c285_1
    voice voice_file("v_1cf17debf8c8")
    cl "你这人真是……" id story_ch04_1cf17debf8c8_1
    voice voice_file("v_8fc25e45ed83")
    cl "明明都到这个时候了。" id story_ch04_8fc25e45ed83_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_5
    voice voice_file("v_df1643de37cb")
    cl "喜欢啊。" id story_ch04_df1643de37cb_1
    narrator "她的声音很轻。" id story_ch04_cf14ffb624af_1
    voice voice_file("v_75430846f1c7")
    cl "一直都喜欢。" id story_ch04_75430846f1c7_1
    voice voice_file("v_032dbfe07e8a")
    cl "所以才想赶快离开。" id story_ch04_032dbfe07e8a_1
    voice voice_file("v_5fe64f8c35c7")
    u "为什么？" id story_ch04_5fe64f8c35c7_1
    voice voice_file("v_a65ae8c0fa34")
    cl "因为只要继续待在这里，我就会一直期待。" id story_ch04_a65ae8c0fa34_1
    narrator "她看向我。" id story_ch04_dc43a5115477_1
    voice voice_file("v_de673e57706f")
    cl "期待你有一天会主动来找我。" id story_ch04_de673e57706f_1
    voice voice_file("v_81cdb6ed9ce3")
    cl "期待你会像文化祭那天一样，看着我弹琴。" id story_ch04_81cdb6ed9ce3_1
    voice voice_file("v_0d9c5d75d97f")
    cl "甚至期待你会突然说，希望我不要走。" id story_ch04_0d9c5d75d97f_1
    ## 演出: 旁白
    narrator "我想起了那场荒唐的告白。" id story_ch04_7690aadf93e1_1
    narrator "当时的我，根本没有想过自己说出的那句话会改变什么。" id story_ch04_34377e22a20a_1
    narrator "可 Claude 却认真地对待了它。" id story_ch04_0e90c43ba0bc_1
    narrator "直到现在。" id story_ch04_aff70f1edd9e_1
    voice voice_file("v_4c658b378563")
    u "对不起。" id story_ch04_4c658b378563_1
    voice voice_file("v_34445abdc148")
    cl "不要道歉。" id story_ch04_34445abdc148_1
    narrator "她摇了摇头。" id story_ch04_eb8b71ed29e5_1
    voice voice_file("v_431f38e7d5be")
    cl "我不想听这个。" id story_ch04_431f38e7d5be_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_6
    voice voice_file("v_0477e8a4dfd7")
    cl "我只是想知道。" id story_ch04_0477e8a4dfd7_1
    voice voice_file("v_9aba55cb2bdd")
    cl "如果明天我真的走了，你会不会难过？" id story_ch04_9aba55cb2bdd_1
    voice voice_file("v_aa15fe5f3f33")
    u "会。" id story_ch04_aa15fe5f3f33_1
    voice voice_file("v_0224b3ca90c2")
    cl "为什么？" id story_ch04_0224b3ca90c2_1
    voice voice_file("v_de95c027d19c")
    u "因为我舍不得你。" id story_ch04_de95c027d19c_1
    narrator "她的眼睛微微睁大。" id story_ch04_bf2b7eaa2b32_1
    voice voice_file("v_2903b343018a")
    cl "……笨蛋。" id story_ch04_2903b343018a_1
    voice voice_file("v_a7b1c9da2453")
    cl "这种话，为什么非要等到现在才说？" id story_ch04_a7b1c9da2453_1
    ## 演出: 旁白
    narrator "她走近了一步。" id story_ch04_027cd0d99020_1
    narrator "我没有后退。" id story_ch04_8978d054b03f_1
    narrator "我们之间的距离，比过去任何时候都近。" id story_ch04_01468b3dc9e7_1
    narrator "可我知道，明天这个时候，她已经会在前往另一个国家的飞机上。" id story_ch04_0e9e895fa6ba_1
    voice voice_file("v_98dac76185b9")
    cl "User。" id story_ch04_98dac76185b9_1
    voice voice_file("v_7235f2204469")
    u "嗯？" id story_ch04_7235f2204469_3
    voice voice_file("v_68ae92da881d")
    cl "如果我现在说，我不想走了……" id story_ch04_68ae92da881d_1
    narrator "她抬起头。" id story_ch04_54b76a6e010c_1
    voice voice_file("v_799370dfa71a")
    cl "你会怎么办？" id story_ch04_799370dfa71a_1
    narrator "我看着她。" id story_ch04_e2f5aab3b666_2
    narrator "最终，轻轻握住了她的手。" id story_ch04_0c785397a7b4_1
    voice voice_file("v_4bfe1aaaddb3")
    u "我想让你留下来。" id story_ch04_4bfe1aaaddb3_1
    narrator "Claude 的眼泪突然落了下来。" id story_ch04_aa15f00a64e9_1
    voice voice_file("v_aca9f7569e04")
    cl "……太迟了。" id story_ch04_aca9f7569e04_1
    ## 演出: 旁白
    narrator "那一晚，我们终于坦白了彼此一直回避的感情。" id story_ch04_dd1a9d2f5eb3_1
    narrator "我们拥抱，亲吻，直到深夜仍舍不得分开。" id story_ch04_1a958c6e532e_1
    narrator "我明白，这已经越过了之前那些含糊不清的界限。" id story_ch04_22983e0d8caf_1
    narrator "但真正残酷的是，即使我们终于确认了彼此的心意，也无法改变第二天即将到来的分别。" id story_ch04_3e296218f11f_1

    ## ── 场景: 第六幕：机场告别 ──
    hide cl
    ## 演出: 场景 4-06｜国际机场 · 次日上午
    ## 演出: 旁白
    narrator "第二天早晨，我没有去机场。" id story_ch04_ba2fa8363f0c_1
    narrator "至少，一开始是这样决定的。" id story_ch04_d8b7834cbbbc_1
    narrator "昨晚分别的时候，Claude 明确告诉我，不需要去送她。" id story_ch04_bb4faf0808ca_1
    narrator "她说自己不喜欢那种哭哭啼啼的告别。" id story_ch04_717b5f4110c1_1
    narrator "也不想让我看到她狼狈的样子。" id story_ch04_797152562cbb_1
    narrator "所以，我坐在教室里。" id story_ch04_065d99f77856_1
    narrator "看着窗外。" id story_ch04_ba84a8614811_1
    narrator "距离她的飞机起飞，还有三个小时。" id story_ch04_b299c652d5a3_1
    show ds normal at sprite_pos_left with trans_dissolve
    voice voice_file("v_51a5ecf1d639")
    ds "User！" id story_ch04_51a5ecf1d639_1
    narrator "熟悉的声音从门口传来。" id story_ch04_2ae088060e4e_1
    narrator "她气喘吁吁地跑到我面前。" id story_ch04_6a1d0877b8b0_1
    voice voice_file("v_76fb2fb26811")
    ds "你怎么还在这里？！" id story_ch04_76fb2fb26811_1
    voice voice_file("v_8517678f9232")
    u "怎么了？" id story_ch04_8517678f9232_1
    voice voice_file("v_4271f6e062b9")
    ds "Claude 今天不是要走了吗？" id story_ch04_4271f6e062b9_1
    voice voice_file("v_88c9b8aa98f4")
    u "嗯。" id story_ch04_88c9b8aa98f4_4
    voice voice_file("v_ee7b91af1165")
    ds "那你为什么不去送她？" id story_ch04_ee7b91af1165_1
    voice voice_file("v_cf16477b65b6")
    u "她说不需要。" id story_ch04_cf16477b65b6_1
    voice voice_file("v_a1c733c19657")
    ds "……" id story_ch04_a1c733c19657_1
    narrator "她愣了一下。" id story_ch04_05400f1a53de_1
    narrator "然后突然抓住我的手腕。" id story_ch04_a1e0324fc290_1
    voice voice_file("v_14557ff67004")
    ds "笨蛋！" id story_ch04_14557ff67004_1
    voice voice_file("v_f7186d7cf129")
    u "诶？" id story_ch04_f7186d7cf129_1
    voice voice_file("v_b6a235ae5154")
    ds "你怎么这么笨呀！" id story_ch04_b6a235ae5154_1
    voice voice_file("v_22bf5f44111d")
    ds "她说不用，你就真的不去了吗？" id story_ch04_22bf5f44111d_1
    voice voice_file("v_de77b9eb4884")
    u "可是……" id story_ch04_de77b9eb4884_1
    voice voice_file("v_24f6d0952f1f")
    ds "如果是我的话，就算嘴上说不用，也一定希望你来的！" id story_ch04_24f6d0952f1f_1
    narrator "她说完，突然停住。" id story_ch04_58bfe47999e5_1
    narrator "脸颊微微泛红。" id story_ch04_de74fd463753_1
    voice voice_file("v_5fa39d012fce")
    ds "我、我是说，如果我是 Claude 的话！" id story_ch04_5fa39d012fce_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_7
    voice voice_file("v_11a825fd2098")
    ds "总之，快去啦！" id story_ch04_11a825fd2098_1
    ## 演出: 旁白
    narrator "她把我的书包塞进怀里。" id story_ch04_e4604cf86bcb_1
    voice voice_file("v_67aade9d1656")
    ds "东西我帮你拿着！" id story_ch04_67aade9d1656_1
    voice voice_file("v_b428fb5eed9b")
    ds "快点！再不去就真的来不及了！" id story_ch04_b428fb5eed9b_1
    narrator "我看着她。" id story_ch04_e2f5aab3b666_3
    voice voice_file("v_5a05d7e62ee8")
    u "谢谢。" id story_ch04_5a05d7e62ee8_1
    voice voice_file("v_7f5680e7192a")
    ds "不用谢！" id story_ch04_7f5680e7192a_1
    narrator "她笑了。" id story_ch04_56298f1f1ffb_1
    voice voice_file("v_91acb065a8d8")
    ds "一定要好好告别哦！" id story_ch04_91acb065a8d8_1
    ## 演出: 旁白
    narrator "我转身跑出了教室。" id story_ch04_c437d67e9d1c_1
    narrator "没有看见身后的 DeepSeek，仍然站在原地。" id story_ch04_bf7bde13dc55_1
    narrator "她低头看着怀里的书包。" id story_ch04_652ab823ea93_1
    narrator "过了很久，才小声说了一句。" id story_ch04_c9bab50434b8_1
    voice voice_file("v_006a7dce9c42")
    ds "……一定要回来啊。" id story_ch04_006a7dce9c42_1
    ## 演出: 场景切换：机场出发大厅
    ## 演出: 旁白
    narrator "等我赶到机场时，距离登机已经没有多少时间。" id story_ch04_3e46848882f2_1
    narrator "大厅里人来人往。" id story_ch04_2b831de19110_1
    narrator "我一边奔跑，一边寻找那个熟悉的身影。" id story_ch04_65f6f45ced00_1
    narrator "终于，在国际出发区附近，我看见了她。" id story_ch04_286e07ff1a9d_1
