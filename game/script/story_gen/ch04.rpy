    voice voice_file("v_810606352b8b")
    ds "而且……" id story_ch04_810606352b8b_1
    voice voice_file("v_a31d48ee1c20")
    u "而且？" id story_ch04_a31d48ee1c20_1
    voice voice_file("v_326b65ea5b65")
