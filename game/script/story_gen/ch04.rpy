    narrator "她突然提高了声音。" id story_ch04_a875513d233e_1
    voice voice_file("v_4875267649ab")
    cl "你会让我留下来吗？" id story_ch04_4875267649ab_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch04_5f55f500d924_1
    voice voice_file("v_33a7f2741cf2")
    cl "还是说，你会跟我一起走？" id story_ch04_33a7f2741cf2_1
    ## 演出: 旁白
    narrator "我无法回答。" id story_ch04_f96eb5d23d6a_1
    narrator "她似乎早就预料到了。" id story_ch04_dec3215a1e82_1
    voice voice_file("v_1023cc0ae2f2")
    cl "所以啊。" id story_ch04_1023cc0ae2f2_1
    voice voice_file("v_eaffaa0f2149")
    cl "告诉你又有什么用呢？" id story_ch04_eaffaa0f2149_1
    narrator "她拿起书包，从我身边走过。" id story_ch04_977768892dcb_1
    narrator "这一次，我没有拦住她。" id story_ch04_02099ad67755_1

    ## ── 场景: 第二幕：一直没有改变的心意 ──
