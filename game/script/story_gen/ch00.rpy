    voice voice_file("v_5ddd706e7312")
    mystery "没、没事！我刚才明明算好了距离的……" id story_ch00_5ddd706e7312_1
    narrator "少女揉着额头，抬起脸。" id story_ch00_c32583d760b5_1
    narrator "蓝色的长发，明亮的眼睛，还有一副完全不知道发生了什么的表情。" id story_ch00_e343930e8a0e_1
    voice voice_file("v_456302ed5493")
    u "你在上面干什么？" id story_ch00_456302ed5493_1
    voice voice_file("v_b5c14d72c4d7")
    mystery "我想看看从那里拍下来的天空是什么样子的呀。" id story_ch00_b5c14d72c4d7_1
    voice voice_file("v_21328cf691c8")
    u "所以你就爬上去了？" id story_ch00_21328cf691c8_1
    voice voice_file("v_ce8357852f40")
    mystery "嗯！" id story_ch00_ce8357852f40_1
    narrator "她回答得理直气壮。" id story_ch00_4dc8223c4f3a_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch00_5f55f500d924_1
    voice voice_file("v_5436934aa60e")
    mystery "啊，不对！这个时候应该先道歉！" id story_ch00_5436934aa60e_1
    voice voice_file("v_638752c34d1b")
    mystery "对不起！！" id story_ch00_638752c34d1b_1
