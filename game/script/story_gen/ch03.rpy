    ds "User！你看这张！" id story_ch03_7e12c4fadac1_1
    voice voice_file("v_c990c2df05fd")
    ds "Claude 笑了诶！她居然真的笑了！" id story_ch03_c990c2df05fd_1
    voice voice_file("v_be0a8f2d7e22")
