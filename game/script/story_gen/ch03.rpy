    voice voice_file("v_2e1fb807deea")
    gp "打扰到你们了吗？" id story_ch03_2e1fb807deea_1
    voice voice_file("v_b0b6eaba982a")
    u "没有！你唱得很好。" id story_ch03_b0b6eaba982a_1
    voice voice_file("v_3f842aea9d45")
    gp "谢谢。" id story_ch03_3f842aea9d45_1
    voice voice_file("v_5313d1cf3dce")
    u "你愿不愿意加入我们的社团？" id story_ch03_5313d1cf3dce_1
    voice voice_file("v_e0e133d4d135")
    gp "电影研究社？" id story_ch03_e0e133d4d135_1
    voice voice_file("v_2be8c6790fda")
    u "嗯。我们正在准备文化祭的作品。" id story_ch03_2be8c6790fda_1
    voice voice_file("v_c906e6732234")
    gp "可是我不太会拍电影。" id story_ch03_c906e6732234_1
