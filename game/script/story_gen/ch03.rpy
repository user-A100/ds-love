    show art_act01_ds_hs_neutral_clean as ds at sprite_pos_left with trans_dissolve
    voice voice_file("v_64cec3867487")
    ds "User！这里这里！" id story_ch03_64cec3867487_1
    voice voice_file("v_9271f86c0b3c")
    u "早上好。" id story_ch03_9271f86c0b3c_1
    voice voice_file("v_008ef497fc8d")
    ds "早上好！我等你好久啦！" id story_ch03_008ef497fc8d_1
    voice voice_file("v_77577c558b2f")
    u "找我有什么事？" id story_ch03_77577c558b2f_1
    voice voice_file("v_93b92c66a068")
    ds "你忘记了吗？" id story_ch03_93b92c66a068_1
    voice voice_file("v_4bc7badb508b")
    u "什么？" id story_ch03_4bc7badb508b_1
    narrator "她鼓起脸颊。" id story_ch03_0054baff6a13_1
    voice voice_file("v_cd7f355b7a1b")
    ds "电影！我们说好要一起拍电影的！" id story_ch03_cd7f355b7a1b_1
    narrator "我愣住了。" id story_ch03_8e1a451c2128_1
    narrator "那已经是好几个月前的约定。" id story_ch03_3d34feb50c19_1
    narrator "自从开始准备考试，我几乎没有再去过电影研究社。" id story_ch03_55ef03988615_1
    voice voice_file("v_609e3892cff7")
    u "抱歉，最近一直在补习。" id story_ch03_609e3892cff7_1
    voice voice_file("v_6d4e30165585")
    ds "我知道啦。" id story_ch03_6d4e30165585_1
    voice voice_file("v_a115b4405210")
    ds "GPT 学姐说你进步了好多呢！" id story_ch03_a115b4405210_1
    voice voice_file("v_4d9c881d09f2")
    u "你还认识她？" id story_ch03_4d9c881d09f2_1
    voice voice_file("v_a20aad975ee2")
    ds "认识呀！我上次去图书馆找你的时候见过她。" id story_ch03_a20aad975ee2_1
    narrator "她翻开手里的笔记本。" id story_ch03_7df0d7f4e0fd_1
    voice voice_file("v_d9360ae1a860")
    ds "你看，我把故事又改了一遍！" id story_ch03_d9360ae1a860_1
    narrator "密密麻麻的文字，旁边还有几张画得歪歪扭扭的分镜草图。" id story_ch03_ecadc1513c3d_1
    voice voice_file("v_2b0ac9bdb3e6")
    u "这些都是你寒假写的？" id story_ch03_2b0ac9bdb3e6_1
    voice voice_file("v_47cf5aac6159")
    ds "嗯！我还想好了结尾！" id story_ch03_47cf5aac6159_1
    voice voice_file("v_37f6ef321b6b")
    u "什么结尾？" id story_ch03_37f6ef321b6b_1
    voice voice_file("v_0b4ded698f6f")
    ds "暂时保密！" id story_ch03_0b4ded698f6f_1
    narrator "她笑着把笔记本合起来。" id story_ch03_213e4e9c0c57_1
    voice voice_file("v_56542778e9f3")
    ds "不过这次，你不可以再忘记啦。" id story_ch03_56542778e9f3_1
    voice voice_file("v_333e949d441c")
    u "好。" id story_ch03_333e949d441c_1
    voice voice_file("v_d9f54c2ff5da")
    ds "约好了？" id story_ch03_d9f54c2ff5da_1
    voice voice_file("v_61aabe748864")
    u "约好了。" id story_ch03_61aabe748864_1
    narrator "她伸出小指。" id story_ch03_7dda7c87c5eb_1
    narrator "我有些无奈地勾了上去。" id story_ch03_ef6daacc6ae6_1
    voice voice_file("v_bb89a78e2dfe")
    ds "拉钩！" id story_ch03_bb89a78e2dfe_1
    ## 演出: 旁白
    narrator "她笑得很开心。" id story_ch03_1b1ae057698d_1
    narrator "而我突然意识到，在我忙着追赶成绩的这段时间里，她一直没有放弃我们最初的约定。" id story_ch03_5d7174b0a485_1

    ## ── 场景: 第二幕：重新成立的电影研究社 ──
    ## 演出: 场景 3-02｜电影研究社活动室 · 放学后
    ## 演出: 旁白
    ## 美术分景 C3-02 · 焕然一新的活动室与《候鸟》
    scene art_act05_bg04_filmclub_clean_winter_evening with trans_dissolve
    narrator "重新走进电影研究社时，我发现活动室已经和之前完全不同。" id story_ch03_3411bf6147b0_1
    narrator "原本堆满灰尘的桌子被擦得干干净净。" id story_ch03_4c3db462df38_1
    narrator "器材整齐地摆在柜子里。" id story_ch03_20aa172b514a_1
    narrator "墙上贴着新的拍摄计划表。" id story_ch03_9c7dd40ca71f_1
    voice voice_file("v_93daef776ac8")
    u "……你一个人整理的？" id story_ch03_93daef776ac8_1
    show art_act01_ds_hs_neutral_clean as ds at sprite_pos_left with trans_dissolve
    voice voice_file("v_57cd12ae7731")
    ds "嗯！" id story_ch03_57cd12ae7731_1
    voice voice_file("v_d6109ce4400e")
    u "花了多久？" id story_ch03_d6109ce4400e_1
    voice voice_file("v_74404fbac861")
    ds "也没有很久啦。" id story_ch03_74404fbac861_1
    narrator "她想了想。" id story_ch03_f209aa4dfd8d_1
    voice voice_file("v_d1a83feb0f01")
    ds "大概……四五天？" id story_ch03_d1a83feb0f01_1
    voice voice_file("v_166ef9542dcc")
    u "四五天？！" id story_ch03_166ef9542dcc_1
    voice voice_file("v_a7782c7ec24c")
    ds "嘿嘿。" id story_ch03_a7782c7ec24c_1
    narrator "我看着桌上的剧本。" id story_ch03_c1860710add1_1
    narrator "第一页写着几个大字。" id story_ch03_8a2f359cccf4_1
    narrator "《候鸟》" id story_ch03_96087e698aa9_1
    voice voice_file("v_e38f8acd1517")
    u "为什么叫这个名字？" id story_ch03_e38f8acd1517_1
    voice voice_file("v_7451ac9a8041")
    ds "因为候鸟每年都会飞很远很远的地方。" id story_ch03_7451ac9a8041_1
    voice voice_file("v_b2963cceb3c0")
    ds "但是不管飞到哪里，它们都会记得自己应该回去的方向。" id story_ch03_b2963cceb3c0_1
    voice voice_file("v_c92df798eb78")
    u "所以这是一个关于回家的故事？" id story_ch03_c92df798eb78_1
    voice voice_file("v_1b850dbd57de")
    ds "差不多吧。" id story_ch03_1b850dbd57de_1
    narrator "她顿了顿。" id story_ch03_e7ebcd8f8699_1
    voice voice_file("v_43fdeadcd28a")
    ds "也可能是一个关于等待的故事。" id story_ch03_43fdeadcd28a_1
    narrator "我翻开剧本。" id story_ch03_bc23e9bcf2ba_1
    narrator "故事讲的是一个成绩很差的少年，在高中最后一年遇见了一位安静的女孩。" id story_ch03_1ceb1f39ab7d_1
    narrator "女孩帮助他重新开始学习。" id story_ch03_cbe8183fe1b9_1
    narrator "少年逐渐喜欢上她。" id story_ch03_59b04c15b132_1
    narrator "他们约定在考试结束后，去同一座城市读大学。" id story_ch03_70d8ac3ea0da_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch03_5f55f500d924_1
    narrator "我抬起头。" id story_ch03_e890b69429d4_1
    voice voice_file("v_b0a7de948c69")
    u "这个故事，怎么有点熟悉？" id story_ch03_b0a7de948c69_1
    voice voice_file("v_8a10fb6a7ccc")
    ds "诶？" id story_ch03_8a10fb6a7ccc_1
    voice voice_file("v_c752b2ad494f")
    u "你是不是听 GPT 学姐讲过我的事情？" id story_ch03_c752b2ad494f_1
    voice voice_file("v_7776beb9ac36")
    ds "没有啦！" id story_ch03_7776beb9ac36_1
    narrator "她有些慌张地摆手。" id story_ch03_f0f06621dbc5_1
    voice voice_file("v_8b9d181e53c5")
    ds "我只是觉得，努力追赶一个人的故事很浪漫嘛！" id story_ch03_8b9d181e53c5_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch03_5f55f500d924_2
    voice voice_file("v_66ea2fdd1212")
    ds "而且你不是说过，电影应该拍一些真正能打动人的东西吗？" id story_ch03_66ea2fdd1212_1
    narrator "我重新看向剧本。" id story_ch03_ba8f5c287abf_1
    narrator "虽然还有很多不成熟的地方，但我不得不承认，她写得比之前好了很多。" id story_ch03_1a3ac36a2b6c_1
    voice voice_file("v_333e949d441c")
    u "好。" id story_ch03_333e949d441c_2
    voice voice_file("v_8a10fb6a7ccc")
    ds "诶？" id story_ch03_8a10fb6a7ccc_2
    voice voice_file("v_87bd1f72506c")
    u "就拍这个。" id story_ch03_87bd1f72506c_1
    voice voice_file("v_aa52563715bf")
    ds "真的？！" id story_ch03_aa52563715bf_1
    voice voice_file("v_c43cdbd87fe2")
    u "嗯。不过，我们需要更多人。" id story_ch03_c43cdbd87fe2_1
    voice voice_file("v_598e80673f87")
    ds "那就去找人！" id story_ch03_598e80673f87_1
    ## 演出: 旁白
    narrator "就这样，停滞许久的电影研究社，终于开始重新运转。" id story_ch03_c361af11d386_1

    ## ── 场景: 第三幕：来自大小姐的帮助 ──
    ## 演出: 场景 3-03｜音乐教室 · 傍晚
    ## 演出: 旁白
    ## 美术分景 C3-03 · 隔壁的钢琴回应
    scene art_act03_bg_musicroom_evening with trans_dissolve
    narrator "为了给电影配乐，我开始尝试自己练习吉他。" id story_ch03_2d6d4869463f_1
    narrator "但我的水平实在算不上好。" id story_ch03_1068e680ca4d_1
    narrator "最开始的几天，我甚至连一首完整的曲子都弹不下来。" id story_ch03_17635f0792de_1
    narrator "奇怪的是，每当我在音乐教室练习时，隔壁总会传来钢琴声。" id story_ch03_c18f4544b46c_1
    narrator "有时，我弹错一个音，钢琴便会停下来。" id story_ch03_c73da9f5a804_1
    narrator "等我重新开始，钢琴又会跟着响起。" id story_ch03_a59fafb01c21_1
    narrator "仿佛有人在故意配合我的演奏。" id story_ch03_514550a32d13_1
    narrator "直到有一天，我终于忍不住推开了隔壁教室的门。" id story_ch03_b99139e8c63d_1
    narrator "坐在钢琴前的人，是 Claude。" id story_ch03_5abd20c6dfd9_1
    voice voice_file("v_8924030a4104")
    u "Claude？" id story_ch03_8924030a4104_1
    narrator "她猛地停下演奏。" id story_ch03_bd4056638ef3_1
    show art_act01_claude_hs_neutral as cl at sprite_pos_center with trans_dissolve
    voice voice_file("v_7820750ca6ed")
    cl "你、你怎么来了？！" id story_ch03_7820750ca6ed_1
    voice voice_file("v_1aa854c45f64")
    u "刚才弹琴的是你？" id story_ch03_1aa854c45f64_1
    voice voice_file("v_5b14f3196246")
    cl "不然呢？" id story_ch03_5b14f3196246_1
    voice voice_file("v_9d00ca0bc13e")
    u "你一直在配合我练习？" id story_ch03_9d00ca0bc13e_1
    voice voice_file("v_709a4bfa6070")
    cl "谁、谁在配合你了！" id story_ch03_709a4bfa6070_1
    narrator "她迅速移开视线。" id story_ch03_e60bda69e19a_1
    voice voice_file("v_9056b9adc451")
    cl "只是你的吉他实在太难听，我听不下去而已。" id story_ch03_9056b9adc451_1
    voice voice_file("v_5f55f500d924")
    u "……" id story_ch03_5f55f500d924_3
    voice voice_file("v_626d9c08e1f4")
    cl "而且你有好几处和弦都弹错了。" id story_ch03_626d9c08e1f4_1
    voice voice_file("v_003eb8c9305e")
    u "那你能教我吗？" id story_ch03_003eb8c9305e_1
    narrator "她看了我一眼。" id story_ch03_fa3bd849cfbc_1
    voice voice_file("v_ee21535a9788")
    cl "你是在请求我？" id story_ch03_ee21535a9788_1
    voice voice_file("v_c91967d4ca2d")
    u "是。" id story_ch03_c91967d4ca2d_1
    voice voice_file("v_d6bb00ebdcec")
    cl "……" id story_ch03_d6bb00ebdcec_1
    narrator "她似乎很满意这个回答。" id story_ch03_34f68ed6c324_1
    voice voice_file("v_60e0346f5023")
    cl "既然你都这么诚恳了，本小姐就勉为其难帮你一次。" id story_ch03_60e0346f5023_1
    ## 演出: 旁白
    scene art_act03_cg_c303_piano_guidance with trans_dissolve
    narrator "那天之后，Claude 开始帮我练习音乐。" id story_ch03_905347929b21_1
    narrator "她的钢琴技术远比我想象中出色。" id story_ch03_f55b0dca028e_1
    narrator "而我也逐渐发现，平时总是高高在上的她，只有坐在钢琴前时，才会露出一种完全不同的神情。" id story_ch03_c7fdbb68c2fa_1
    narrator "安静。" id story_ch03_4168cb347a1d_1
    narrator "专注。" id story_ch03_270d508365cc_1
    narrator "甚至有些孤独。" id story_ch03_6b52097ecda7_1

