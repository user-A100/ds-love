    narrator "我顺着声音走过去。" id story_ch03_58e2bb9d67b5_1
    narrator "推开门。" id story_ch03_d1153576c582_1
    narrator "站在窗边的人，是 GPT。" id story_ch03_ee2c308e4d1e_1
