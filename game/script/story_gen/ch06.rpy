    narrator "过了一会儿，她突然安静下来。" id story_ch06_12dbdd2aad27_1
    voice voice_file("v_0a84887f827d")
    ds "User。" id story_ch06_0a84887f827d_1
    voice voice_file("v_7235f2204469")
    u "嗯？" id story_ch06_7235f2204469_1
    voice voice_file("v_e5894e2839ed")
    ds "我下个月可能要去外地参加一个创作项目。" id story_ch06_e5894e2839ed_1
    voice voice_file("v_5b82bd36228a")
    u "外地？" id story_ch06_5b82bd36228a_1
    voice voice_file("v_9b516859a8fc")
