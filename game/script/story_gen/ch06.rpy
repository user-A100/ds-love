    voice voice_file("v_41b3b9e52937")
    u "很好。" id story_ch06_41b3b9e52937_1
    voice voice_file("v_b5ca0b79526d")
    ds "真的？" id story_ch06_b5ca0b79526d_1
    voice voice_file("v_88c9b8aa98f4")
    u "嗯。" id story_ch06_88c9b8aa98f4_2
