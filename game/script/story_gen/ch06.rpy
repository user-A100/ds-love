    voice voice_file("v_646f2cc87a2b")
    ds "所以……" id story_ch06_646f2cc87a2b_1
    narrator "她轻轻吸了一口气。" id story_ch06_6d3d14c8632f_1
    voice voice_file("v_418761184967")
    ds "请你认真告诉我吧。" id story_ch06_418761184967_1

